{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "汽车改装合规通行证领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "PLAN_DECLARED",
        "PART_BOUND",
        "WORK_ATTESTED",
        "INSPECTION_SIGNED",
        "PASS_ACTIVATED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "vehicle_profile",
        "modification_plan",
        "inspection_decision",
        "compliance_pass"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
